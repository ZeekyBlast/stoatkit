{
  "name": "stoatkit",
  "version": "0.3.0",
  "description": "A bot framework for Stoat (formerly Revolt) with discord.js-style ergonomics",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "gen:types": "npx -y -p openapi-typescript@7.13.0 -p typescript@5 openapi-typescript https://api.stoat.chat/openapi.json -o src/generated/api.ts && node scripts/spec-version.ts write",
    "check:spec": "node scripts/spec-version.ts check",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "author": "ZeekyBlast",
  "homepage": "https://github.com/ZeekyBlast/stoatkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeekyBlast/stoatkit.git"
  },
  "bugs": {
    "url": "https://github.com/ZeekyBlast/stoatkit/issues"
  },
  "keywords": [
    "stoat",
    "revolt",
    "bot",
    "framework",
    "chat",
    "discord.js",
    "discord-bot",
    "stoat.js",
    "revolt.js",
    "typescript"
  ]
}
